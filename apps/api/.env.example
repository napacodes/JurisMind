# Development API port
PORT=4000
NODE_ENV=development

# Exact browser origins allowed to call the cookie-authenticated API.
TRUSTED_ORIGINS=http://localhost:3000

# Authentication policy. Production deployments must set explicit trusted HTTPS origins.
SESSION_TTL_SECONDS=43200
PASSWORD_MIN_LENGTH=12
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
INVITATION_DEV_TOKEN_DELIVERY=false

# Password recovery gateway: configure all three values to enable mail delivery.
# The API sends {from,to,subject,text} JSON with Bearer authorization to an HTTPS endpoint.
PUBLIC_WEB_URL=http://localhost:3000
PASSWORD_RESET_EMAIL_ENDPOINT=
PASSWORD_RESET_EMAIL_API_KEY=
PASSWORD_RESET_EMAIL_FROM=
# Local browser QA only. Requires NODE_ENV=development and a process-only random key.
LOCAL_PASSWORD_RESET_SINK_ENABLED=false
LOCAL_PASSWORD_RESET_SINK_KEY=

# Generate a unique 32-byte key and base64-encode it locally. In production, keep it in
# a managed secret store (preferably KMS-backed) and define an explicit rotation plan.
MFA_ENCRYPTION_KEY=

# Local development placeholders only. Replace these values before starting PostgreSQL.
# This file contains no working credentials and must not be used as a production secret.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/jurismind_dev?schema=public
POSTGRES_USER=USER
POSTGRES_PASSWORD=PASSWORD
POSTGRES_DB=jurismind_dev
