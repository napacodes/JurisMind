# Development API port
PORT=4000
NODE_ENV=development

# Exact browser origins allowed to call the cookie-authenticated API.
TRUSTED_ORIGINS=http://localhost:3000

# Authentication policy. Production deployments must set explicit trusted HTTPS origins.
SESSION_TTL_SECONDS=43200
PASSWORD_MIN_LENGTH=12
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
INVITATION_DEV_TOKEN_DELIVERY=false

# Password recovery gateway: configure all three values to enable mail delivery.
# The API sends {from,to,subject,text} JSON with Bearer authorization to an HTTPS endpoint.
PUBLIC_WEB_URL=http://localhost:3000
PASSWORD_RESET_EMAIL_ENDPOINT=
PASSWORD_RESET_EMAIL_API_KEY=
PASSWORD_RESET_EMAIL_FROM=
# Local browser QA only. Requires NODE_ENV=development and a process-only random key.
LOCAL_PASSWORD_RESET_SINK_ENABLED=false
LOCAL_PASSWORD_RESET_SINK_KEY=

# Generate a unique 32-byte key and base64-encode it locally. In production, keep it in
# a managed secret store (preferably KMS-backed) and define an explicit rotation plan.
MFA_ENCRYPTION_KEY=

# Lawyer-card identifiers are encrypted before storage with a separate 32-byte key.
# Required in production. Supply it through a secret manager, not source control.
LAWYER_CREDENTIAL_ENCRYPTION_KEY=

# Private KYC and lawyer-credential documents. Local storage is for development only.
# Production requires S3-compatible storage with private bucket settings (block public
# access, disable public ACLs, and grant this API only object read/write/delete access).
PRIVATE_DOCUMENT_STORAGE_DRIVER=local
PRIVATE_DOCUMENT_S3_ENDPOINT=
PRIVATE_DOCUMENT_S3_REGION=
PRIVATE_DOCUMENT_S3_BUCKET=
# Supply through a managed secret store; never commit real credentials.
PRIVATE_DOCUMENT_S3_ACCESS_KEY_ID=
PRIVATE_DOCUMENT_S3_SECRET_ACCESS_KEY=

# Firm KYC document requirements by jurisdiction|legal form. Defaults preserve the
# current required registration and representative-authority documents. Add only
# jurisdiction-specific rules approved by counsel/compliance; unsupported file kinds
# are rejected. Example: {"default":["REGISTRATION","AUTHORITY"],"byJurisdictionAndLegalForm":{"example district|limited liability company":["REGISTRATION"]}}
FIRM_KYC_DOCUMENT_POLICY_JSON=
# Lawyer license documents are required by default. Overrides are keyed by jurisdiction.
# Example: {"default":true,"byJurisdiction":{"example district":false}}
LAWYER_CREDENTIAL_DOCUMENT_POLICY_JSON=

# Optional review validity periods. Unset means no automatic expiry is applied.
# The API records an expiry at approval and changes overdue approvals to EXPIRED
# on the next authorized status/review-list request. Renewals require a new review.
FIRM_VERIFICATION_VALIDITY_DAYS=
LAWYER_CREDENTIAL_VALIDITY_DAYS=

# Local development placeholders only. Replace these values before starting PostgreSQL.
# This file contains no working credentials and must not be used as a production secret.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/jurismind_dev?schema=public
POSTGRES_USER=USER
POSTGRES_PASSWORD=PASSWORD
POSTGRES_DB=jurismind_dev
