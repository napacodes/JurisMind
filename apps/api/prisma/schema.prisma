generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum WorkspaceKind {
  FIRM
  INDIVIDUAL
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum MembershipRole {
  FIRM_ADMIN
  LAWYER
  ASSISTANT
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum LawyerCredentialSubmissionStatus {
  DRAFT
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  EXPIRED
}

enum FirmVerificationStatus {
  DRAFT
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  EXPIRED
}

enum FirmVerificationDocumentType {
  REGISTRATION
  AUTHORITY
}

enum ContentEntryType {
  BLOG_POST
  INFORMATIONAL_PAGE
}

enum ContentEntryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PlatformRole {
  SUPER_ADMIN
}

enum LoginAudience {
  ADMINISTRATION
  FIRM
  LAWYER
  ASSISTANT
}

model User {
  id                            String                       @id @default(uuid()) @db.Uuid
  email                         String                       @db.VarChar(320)
  emailNormalized               String                       @unique @map("email_normalized") @db.VarChar(320)
  fullName                      String                       @map("full_name") @db.VarChar(200)
  passwordHash                  String?                      @map("password_hash") @db.VarChar(255)
  emailVerifiedAt               DateTime?                    @map("email_verified_at") @db.Timestamptz(6)
  status                        UserStatus                   @default(ACTIVE)
  createdAt                     DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships                   PracticeMembership[]
  sessions                      UserSession[]
  platformRoleGrants            PlatformRoleGrant[]          @relation("GrantedUser")
  grantedPlatformRoles          PlatformRoleGrant[]          @relation("RoleGrantor")
  auditEvents                   SecurityAuditEvent[]         @relation("AuditActor")
  createdInvitations            WorkspaceInvitation[]        @relation("InvitationCreator")
  receivedInvitations           WorkspaceInvitation[]        @relation("InvitationRecipient")
  passwordResetTokens           PasswordResetToken[]
  mfa                           UserMfa?
  reviewedCredentialSubmissions LawyerCredentialSubmission[] @relation("CredentialReviewer")
  submittedFirmVerifications    FirmVerificationSubmission[] @relation("FirmVerificationSubmitter")
  reviewedFirmVerifications     FirmVerificationSubmission[] @relation("FirmVerificationReviewer")
  createdContentEntries         ContentEntry[]               @relation("ContentCreator")
  updatedContentEntries         ContentEntry[]               @relation("ContentUpdater")

  @@map("users")
}

model PracticeWorkspace {
  id                String                       @id @default(uuid()) @db.Uuid
  name              String                       @db.VarChar(200)
  slug              String                       @unique @db.VarChar(100)
  kind              WorkspaceKind
  status            WorkspaceStatus              @default(ACTIVE)
  createdAt         DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships       PracticeMembership[]
  auditEvents       SecurityAuditEvent[]
  invitations       WorkspaceInvitation[]
  firmVerifications FirmVerificationSubmission[]

  @@map("practice_workspaces")
}

model PracticeMembership {
  id                            String                       @id @default(uuid()) @db.Uuid
  workspaceId                   String                       @map("workspace_id") @db.Uuid
  userId                        String                       @map("user_id") @db.Uuid
  role                          MembershipRole
  status                        MembershipStatus             @default(INVITED)
  supervisingLawyerMembershipId String?                      @map("supervising_lawyer_membership_id") @db.Uuid
  joinedAt                      DateTime?                    @map("joined_at") @db.Timestamptz(6)
  createdAt                     DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace                     PracticeWorkspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user                          User                         @relation(fields: [userId], references: [id], onDelete: Restrict)
  supervisor                    PracticeMembership?          @relation("LawyerAssistant", fields: [supervisingLawyerMembershipId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  assistants                    PracticeMembership[]         @relation("LawyerAssistant")
  lawyerProfile                 LawyerProfile?
  credentialSubmissions         LawyerCredentialSubmission[]
  invitations                   WorkspaceInvitation[]

  @@unique([workspaceId, userId])
  @@unique([id, workspaceId])
  @@index([userId, status])
  @@index([workspaceId, role, status])
  @@index([supervisingLawyerMembershipId, workspaceId])
  @@map("practice_memberships")
}

model WorkspaceInvitation {
  id              String             @id @default(uuid()) @db.Uuid
  workspaceId     String             @map("workspace_id") @db.Uuid
  membershipId    String             @map("membership_id") @db.Uuid
  recipientUserId String             @map("recipient_user_id") @db.Uuid
  intendedEmail   String             @map("intended_email") @db.VarChar(320)
  role            MembershipRole
  tokenHash       String             @unique @map("token_hash") @db.Char(64)
  createdById     String             @map("created_by_id") @db.Uuid
  status          InvitationStatus   @default(PENDING)
  expiresAt       DateTime           @map("expires_at") @db.Timestamptz(6)
  acceptedAt      DateTime?          @map("accepted_at") @db.Timestamptz(6)
  revokedAt       DateTime?          @map("revoked_at") @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace       PracticeWorkspace  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  membership      PracticeMembership @relation(fields: [membershipId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  recipient       User               @relation("InvitationRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)
  createdBy       User               @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([workspaceId, status, expiresAt])
  @@index([recipientUserId, status, expiresAt])
  @@index([membershipId, status])
  @@map("workspace_invitations")
}

model LawyerProfile {
  id           String             @id @default(uuid()) @db.Uuid
  workspaceId  String             @map("workspace_id") @db.Uuid
  membershipId String             @unique @map("membership_id") @db.Uuid
  isPrimary    Boolean            @default(false) @map("is_primary")
  displayTitle String?            @map("display_title") @db.VarChar(120)
  jurisdiction String?            @db.VarChar(120)
  barNumber    String?            @map("bar_number") @db.VarChar(120)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  membership   PracticeMembership @relation(fields: [membershipId, workspaceId], references: [id, workspaceId], onDelete: Restrict)

  @@unique([membershipId, workspaceId])
  @@map("lawyer_profiles")
}

model PlatformRoleGrant {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  role        PlatformRole
  grantedById String?      @map("granted_by_id") @db.Uuid
  grantedAt   DateTime     @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt   DateTime?    @map("revoked_at") @db.Timestamptz(6)
  user        User         @relation("GrantedUser", fields: [userId], references: [id], onDelete: Restrict)
  grantedBy   User?        @relation("RoleGrantor", fields: [grantedById], references: [id], onDelete: Restrict)

  @@index([userId, role, revokedAt])
  @@map("platform_role_grants")
}

model UserSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  audience   LoginAudience @default(FIRM)
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt, expiresAt])
  @@map("user_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

model UserMfa {
  userId                  String              @id @map("user_id") @db.Uuid
  secretCiphertext        String?             @map("secret_ciphertext") @db.Text
  pendingSecretCiphertext String?             @map("pending_secret_ciphertext") @db.Text
  pendingExpiresAt        DateTime?           @map("pending_expires_at") @db.Timestamptz(6)
  enabledAt               DateTime?           @map("enabled_at") @db.Timestamptz(6)
  lastTotpCounter         Int                 @default(-1) @map("last_totp_counter")
  updatedAt               DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                    User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  recoveryCodes           MfaRecoveryCode[]
  challenges              LoginMfaChallenge[]

  @@map("user_mfa")
}

model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  mfa       UserMfa   @relation(fields: [userId], references: [userId], onDelete: Restrict)

  @@unique([userId, codeHash])
  @@index([userId, usedAt])
  @@map("mfa_recovery_codes")
}

model LoginMfaChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  audience   LoginAudience @default(FIRM)
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  mfa        UserMfa   @relation(fields: [userId], references: [userId], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@map("login_mfa_challenges")
}

model SecurityAuditEvent {
  id          String             @id @default(uuid()) @db.Uuid
  actorUserId String?            @map("actor_user_id") @db.Uuid
  workspaceId String?            @map("workspace_id") @db.Uuid
  eventType   String             @map("event_type") @db.VarChar(120)
  targetType  String?            @map("target_type") @db.VarChar(120)
  targetId    String?            @map("target_id") @db.VarChar(200)
  requestId   String?            @map("request_id") @db.VarChar(120)
  metadata    Json?
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  actor       User?              @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  workspace   PracticeWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([eventType, createdAt])
  @@map("security_audit_events")
}

model ContentEntry {
  id             String             @id @default(uuid()) @db.Uuid
  type           ContentEntryType
  status         ContentEntryStatus @default(DRAFT)
  slug           String             @unique @db.VarChar(120)
  title          String             @db.VarChar(180)
  summary        String             @db.VarChar(500)
  body           String             @db.Text
  seoTitle       String?            @map("seo_title") @db.VarChar(180)
  seoDescription String?            @map("seo_description") @db.VarChar(320)
  createdById    String             @map("created_by_id") @db.Uuid
  updatedById    String             @map("updated_by_id") @db.Uuid
  publishedAt    DateTime?          @map("published_at") @db.Timestamptz(6)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      User               @relation("ContentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy      User               @relation("ContentUpdater", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([status, type, publishedAt])
  @@index([updatedAt])
  @@map("content_entries")
}

model LawyerCredentialSubmission {
  id                       String                           @id @default(uuid()) @db.Uuid
  workspaceId              String                           @map("workspace_id") @db.Uuid
  membershipId             String                           @map("membership_id") @db.Uuid
  cardHolderName           String                           @map("card_holder_name") @db.VarChar(200)
  jurisdiction             String                           @db.VarChar(120)
  professionalRegulator    String                           @default("Legacy record") @map("professional_regulator") @db.VarChar(160)
  cardIdentifierCiphertext String                           @map("card_identifier_ciphertext") @db.Text
  cardIdentifierLast4      String                           @map("card_identifier_last4") @db.Char(4)
  status                   LawyerCredentialSubmissionStatus @default(PENDING)
  reviewReason             String?                          @map("review_reason") @db.VarChar(1000)
  reviewedById             String?                          @map("reviewed_by_id") @db.Uuid
  reviewedAt               DateTime?                        @map("reviewed_at") @db.Timestamptz(6)
  expiresAt                DateTime?                        @map("expires_at") @db.Timestamptz(6)
  createdAt                DateTime                         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                         @updatedAt @map("updated_at") @db.Timestamptz(6)
  membership               PracticeMembership               @relation(fields: [membershipId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  reviewedBy               User?                            @relation("CredentialReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  documents                LawyerCredentialDocument[]

  @@unique([id, workspaceId, membershipId])
  @@index([workspaceId, status, createdAt])
  @@index([membershipId, createdAt])
  @@map("lawyer_credential_submissions")
}

model LawyerCredentialDocument {
  id           String                     @id @default(uuid()) @db.Uuid
  submissionId String                     @map("submission_id") @db.Uuid
  workspaceId  String                     @map("workspace_id") @db.Uuid
  membershipId String                     @map("membership_id") @db.Uuid
  storageKey   String                     @unique @map("storage_key") @db.VarChar(100)
  mediaType    String                     @map("media_type") @db.VarChar(80)
  sizeBytes    Int                        @map("size_bytes")
  sha256       String                     @db.Char(64)
  createdAt    DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  submission   LawyerCredentialSubmission @relation(fields: [submissionId, workspaceId, membershipId], references: [id, workspaceId, membershipId], onDelete: Restrict)

  @@index([submissionId])
  @@map("lawyer_credential_documents")
}

model FirmVerificationSubmission {
  id                String                     @id @default(uuid()) @db.Uuid
  workspaceId       String                     @map("workspace_id") @db.Uuid
  submittedById     String                     @map("submitted_by_id") @db.Uuid
  detailsCiphertext String                     @map("details_ciphertext") @db.Text
  status            FirmVerificationStatus     @default(PENDING)
  reviewReason      String?                    @map("review_reason") @db.VarChar(1000)
  reviewedById      String?                    @map("reviewed_by_id") @db.Uuid
  reviewedAt        DateTime?                  @map("reviewed_at") @db.Timestamptz(6)
  expiresAt         DateTime?                  @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace         PracticeWorkspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  submittedBy       User                       @relation("FirmVerificationSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy        User?                      @relation("FirmVerificationReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  documents         FirmVerificationDocument[]

  @@index([workspaceId, status, createdAt])
  @@index([submittedById, createdAt])
  @@map("firm_verification_submissions")
}

model FirmVerificationDocument {
  id           String                       @id @default(uuid()) @db.Uuid
  submissionId String                       @map("submission_id") @db.Uuid
  documentType FirmVerificationDocumentType @map("document_type")
  storageKey   String                       @unique @map("storage_key") @db.VarChar(100)
  mediaType    String                       @map("media_type") @db.VarChar(80)
  sizeBytes    Int                          @map("size_bytes")
  sha256       String                       @db.Char(64)
  createdAt    DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  submission   FirmVerificationSubmission   @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  @@index([submissionId])
  @@map("firm_verification_documents")
}
